{
	"name": "canvas-interface",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsc-watch --onSuccess \"npm run dev-frontend && npm start\"",
		"dev-frontend": "npx nodemon -e \"*\" -w \"src/frontend\" -x \"vite build\"",
		"build": "npm run build-backend && npm run build-frontend",
		"build-backend": "tsc -b src/backend",
		"build-frontend": "vite build",
		"start": "node dist/backend/index.js",
		"lint": "npm run lint-ts; npm run lint-scss",
		"lint-ts": "eslint src",
		"lint-scss": "stylelint src/frontend/css"
	},
	"dependencies": {
		"@fastify/static": "^7.0.4",
		"@types/node": "^22.5.4",
		"@urql/core": "^5.0.6",
		"fastify": "^4.28.1",
		"sass": "^1.78.0",
		"typescript": "^5.5.4",
		"vite": "^5.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.10.0",
		"@stylistic/eslint-plugin": "^2.7.2",
		"@types/eslint__js": "^8.42.3",
		"eslint": "^9.10.0",
		"nodemon": "^3.1.4",
		"stylelint": "^16.9.0",
		"stylelint-config-standard-scss": "^13.1.0",
		"stylelint-order": "^6.0.4",
		"tsc-watch": "^6.2.0",
		"typescript-eslint": "^8.4.0"
	}
}
