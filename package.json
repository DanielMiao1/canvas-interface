{
	"name": "canvas-interface",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsc-watch --onSuccess \"npm run dev-frontend && npm start\"",
		"dev-frontend": "npx nodemon -e \"*\" -w \"src/frontend\" -x \"vite build\"",
		"build": "npm run build-backend && npm run build-frontend",
		"build-backend": "tsc -b",
		"build-frontend": "vite build",
		"start": "node dist/backend/index.js"
	},
	"dependencies": {
		"@fastify/static": "^7.0.4",
		"@types/node": "^22.2.0",
		"fastify": "^4.28.1",
		"sass": "^1.77.8",
		"typescript": "^5.5.3",
		"vite": "^5.4.1"
	},
	"devDependencies": {
		"nodemon": "^3.1.4",
		"tsc-watch": "^6.2.0"
	}
}
