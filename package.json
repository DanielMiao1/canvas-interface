{
	"name": "canvas-interface",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsc-watch -p src/backend --onSuccess \"npm run dev-frontend && npm start\"",
		"dev-frontend": "npx nodemon -e \"*\" -w \"src/frontend\" -x \"vite build\"",
		"build": "npm run build-backend && npm run build-frontend",
		"build-backend": "tsc -b src/backend",
		"build-frontend": "vite build",
		"start": "node dist/backend/index.js",
		"lint": "npm run lint-ts && npm run lint-scss",
		"lint-ts": "eslint src",
		"lint-scss": "stylelint src/frontend/css"
	},
	"dependencies": {
		"@fastify/formbody": "^8.0.1",
		"@fastify/static": "^8.0.3",
		"@types/node": "^22.9.3",
		"@urql/core": "^5.0.8",
		"fastify": "^5.1.0",
		"sass": "^1.81.0",
		"typescript": "^5.7.2",
		"vite": "^5.4.11"
	},
	"devDependencies": {
		"@eslint/js": "^9.15.0",
		"@stylistic/eslint-plugin": "^2.11.0",
		"@types/eslint__js": "^8.42.3",
		"eslint": "^9.16.0",
		"nodemon": "^3.1.7",
		"stylelint": "^16.10.0",
		"stylelint-config-standard-scss": "^14.0.0",
		"stylelint-order": "^6.0.4",
		"tsc-watch": "^6.2.1",
		"typescript-eslint": "^8.17.0"
	}
}
